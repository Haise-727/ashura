#!/usr/bin/env python3
"""ashura-spotify: the small part of Spotify's Web API the Ashura music bar uses.

One-time setup:
  1. Create an app at https://developer.spotify.com/dashboard (any name).
     Redirect URI: http://127.0.0.1:8898/callback   APIs: Web API.
  2. Put its Client ID in ~/.config/ashura/spotify.json:
        { "client_id": "..." }
  3. ashura-spotify login     (opens the browser once)

Then:
  ashura-spotify status            {"configured":..,"signedIn":..}
  ashura-spotify queue             what plays next (JSON)
  ashura-spotify liked <track-id>  true / false
  ashura-spotify like <track-id>   ashura-spotify unlike <track-id>

The sign-in uses PKCE, so no client secret is stored. Tokens live in
~/.local/state/ashura/spotify-token.json, readable only by you.
Every command prints JSON and exits 0, with {"error": ...} when it cannot
answer, so the shell never has to parse a traceback.
"""
import base64
import hashlib
import http.server
import json
import os
import secrets
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
CONFIG = os.path.join(HOME, ".config", "ashura", "spotify.json")
TOKEN = os.path.join(HOME, ".local", "state", "ashura", "spotify-token.json")
PORT = 8898
REDIRECT = f"http://127.0.0.1:{PORT}/callback"
SCOPES = " ".join([
    "user-read-playback-state", "user-modify-playback-state", "user-read-currently-playing",
    "user-library-read", "user-library-modify", "playlist-read-private",
])


def out(obj):
    print(json.dumps(obj, ensure_ascii=False))
    sys.exit(0)


def client_id():
    try:
        with open(CONFIG) as f:
            return json.load(f).get("client_id", "").strip()
    except (OSError, ValueError):
        return ""


def load_token():
    try:
        with open(TOKEN) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_token(tok):
    os.makedirs(os.path.dirname(TOKEN), exist_ok=True)
    fd = os.open(TOKEN + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(tok, f)
    os.replace(TOKEN + ".tmp", TOKEN)


def post_form(url, data):
    req = urllib.request.Request(url, data=urllib.parse.urlencode(data).encode(),
                                 headers={"Content-Type": "application/x-www-form-urlencoded"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)


def access_token():
    tok = load_token()
    if not tok:
        return None
    if tok.get("expires_at", 0) - 60 > time.time():
        return tok["access_token"]
    try:
        new = post_form("https://accounts.spotify.com/api/token", {
            "grant_type": "refresh_token", "refresh_token": tok["refresh_token"], "client_id": client_id()})
    except (urllib.error.URLError, KeyError, ValueError):
        return None
    tok["access_token"] = new["access_token"]
    tok["expires_at"] = time.time() + new.get("expires_in", 3600)
    if new.get("refresh_token"):
        tok["refresh_token"] = new["refresh_token"]
    save_token(tok)
    return tok["access_token"]


def api(method, path):
    at = access_token()
    if not at:
        out({"error": "not signed in"})
    req = urllib.request.Request("https://api.spotify.com/v1" + path, method=method,
                                 headers={"Authorization": f"Bearer {at}"})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            body = r.read()
            return json.loads(body) if body else None
    except urllib.error.HTTPError as e:
        out({"error": f"spotify said {e.code}"})
    except urllib.error.URLError:
        out({"error": "offline"})


def track(t):
    return {"id": t.get("id"), "title": t.get("name", ""),
            "artist": ", ".join(a.get("name", "") for a in t.get("artists", [])) or t.get("show", {}).get("name", "")}


def login():
    cid = client_id()
    if not cid:
        out({"error": f"no client_id in {CONFIG}"})
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(16)
    url = "https://accounts.spotify.com/authorize?" + urllib.parse.urlencode({
        "client_id": cid, "response_type": "code", "redirect_uri": REDIRECT, "scope": SCOPES,
        "code_challenge_method": "S256", "code_challenge": challenge, "state": state})
    got = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if q.get("state", [""])[0] == state:
                got.update({k: v[0] for k, v in q.items()})
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write("Ashura is signed in to Spotify. You can close this tab.".encode()
                             if "code" in got else "Sign-in did not finish. Run ashura-spotify login again.".encode())

        def log_message(self, *a):
            pass

    srv = http.server.HTTPServer(("127.0.0.1", PORT), Handler)
    srv.timeout = 180
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print("Opened the browser to sign in to Spotify (waiting up to 3 minutes)...", file=sys.stderr)
    srv.handle_request()
    if "code" not in got:
        out({"error": got.get("error", "no answer from the browser")})
    tok = post_form("https://accounts.spotify.com/api/token", {
        "grant_type": "authorization_code", "code": got["code"], "redirect_uri": REDIRECT,
        "client_id": cid, "code_verifier": verifier})
    save_token({"access_token": tok["access_token"], "refresh_token": tok["refresh_token"],
                "expires_at": time.time() + tok.get("expires_in", 3600)})
    out({"signedIn": True})


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "status"
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
        return
    if cmd == "login":
        login()
    if cmd == "status":
        out({"configured": bool(client_id()), "signedIn": load_token() is not None})
    if cmd == "queue":
        q = api("GET", "/me/player/queue") or {}
        cur = q.get("currently_playing")
        out({"current": track(cur) if cur else None, "next": [track(t) for t in q.get("queue", [])[:5]]})
    if cmd in ("liked", "like", "unlike") and len(args) == 2:
        tid = urllib.parse.quote(args[1])
        if cmd == "liked":
            r = api("GET", f"/me/tracks/contains?ids={tid}")
            out({"liked": bool(r and r[0])})
        api("PUT" if cmd == "like" else "DELETE", f"/me/tracks?ids={tid}")
        out({"liked": cmd == "like"})
    out({"error": f"unknown command: {' '.join(args)}"})


if __name__ == "__main__":
    main()
